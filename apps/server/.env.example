DATABASE_URL=postgresql://postgres:password@localhost:5432/scholar-seek
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
# Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sole initial account — public sign-up is disabled
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=
ROOT_ADMIN_NAME=Root Admin
# Optional: Semantic Scholar API key (free, https://www.semanticscholar.org/product/api#Partner-Form)
# S2_API_KEY=
# Optional: ML service reload token (must match RELOAD_TOKEN in ml-service/.env)
# ML_RELOAD_TOKEN=change-me
